def pdf_page_to_image(pdf_path: str, page_num: int, dpi: int = 300) -> Tuple[bytes, str]:
    """
    Convert a specific PDF page to a high-resolution image.
    
    Args:
        pdf_path: Path to the PDF file
        page_num: Page number (0-indexed)
        dpi: Resolution for rendering (default 300 for quality)
    
    Returns:
        Tuple of (image_bytes, format)
    """
    try:
        doc = fitz.open(pdf_path)
        
        if page_num >= len(doc):
            raise ValueError(f"Page {page_num} does not exist. PDF has {len(doc)} pages.")
        
        page = doc[page_num]
        
        # Calculate zoom factor for desired DPI (72 is default PDF DPI)
        zoom = dpi / 72
        mat = fitz.Matrix(zoom, zoom)
        
        # Render page to pixmap
        pix = page.get_pixmap(matrix=mat)
        
        # Convert to PNG bytes
        img_bytes = pix.tobytes("png")

        # DEBUG: Save image for inspection
        debug_path = f"/home/user/projects/EarningsAI_V2_Final/scripts/Images/debug_page_{page_num+1}.png"
        with open(debug_path, 'wb') as f:
            f.write(img_bytes)
        logger.info(f"DEBUG: Saved image to {debug_path}")
        
        doc.close()
        
        logger.info(f"Converted page {page_num + 1} to image ({pix.width}x{pix.height})")
        return img_bytes, "png"
        doc.close()
        
        logger.info(f"Converted page {page_num + 1} to image ({pix.width}x{pix.height})")
        return img_bytes, "png"
        
    except Exception as e:
        logger.error(f"Error converting page {page_num} to image: {str(e)}")
        raise


def get_pdf_page_count(pdf_path: str) -> int:
    """Get the total number of pages in a PDF."""
    doc = fitz.open(pdf_path)
    count = len(doc)
    doc.close()
    return count


def get_preprocessing_context(pdf_path: str, page_num: int) -> str:
    """
    Extract preprocessing context from PDF using existing pdf_processor.
    This provides textual context that may help the LLM but might be inaccurate.
    
    Args:
        pdf_path: Path to the PDF file
        page_num: Page number (0-indexed)
    
    Returns:
        Extracted text context for the specific page
    """
    try:
        # Use PyPDFLoader for page-specific text
        from langchain_community.document_loaders import PyPDFLoader
        
        loader = PyPDFLoader(pdf_path)
        documents = loader.load()
        
        if page_num < len(documents):
            page_text = documents[page_num].page_content
            return clean_text(page_text)
        
        return ""
        
    except Exception as e:
        logger.warning(f"Could not extract preprocessing context for page {page_num}: {str(e)}")
        return ""


def extract_tables_context(pdf_path: str, page_num: int) -> str:
    """
    Extract table context from a specific PDF page using pdfplumber.
    
    Args:
        pdf_path: Path to the PDF file
        page_num: Page number (0-indexed)
    
    Returns:
        Extracted table text
    """
    try:
        import pdfplumber
        
        with pdfplumber.open(pdf_path) as pdf:
            if page_num < len(pdf.pages):
                page = pdf.pages[page_num]
                tables = page.extract_tables()
                
                if tables:
                    table_texts = []
                    for idx, table in enumerate(tables):
                        if table and len(table) > 0:
                            # Convert table to simple text representation
                            rows = []
                            for row in table:
                                row_text = " | ".join(str(cell) if cell else "" for cell in row)
                                rows.append(row_text)
                            table_texts.append(f"Table {idx + 1}:\n" + "\n".join(rows))
                    
                    return "\n\n".join(table_texts)
        
        return ""
        
    except Exception as e:
        logger.warning(f"Could not extract table context for page {page_num}: {str(e)}")
        return ""


